[Unit]
Description=PolyCopy Sync Engine
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/PolyCopy
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/PolyCopy/.venv/bin/python run_engine.py
Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
