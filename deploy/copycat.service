[Unit]
Description=PolyCopy Dash App
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/PolyCopy
Environment=PYTHONUNBUFFERED=1
Environment=HOST=0.0.0.0
Environment=PORT=8060
ExecStart=/home/ec2-user/PolyCopy/.venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:8060 wsgi:server
Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
